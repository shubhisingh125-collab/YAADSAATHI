# YaadSaathi Environment Configuration Template
# Duplicate this file as .env.local and populate with your keys.

# -----------------------------------------------------------------
# 1. Google Gemini AI (Server-side Only)
# -----------------------------------------------------------------
# Keep secret! Used by Netlify Functions / local backend proxy server.
# NEVER prefix with VITE_ or expose to browser.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 2. Supabase Cloud Configuration (Frontend)
# -----------------------------------------------------------------
# Safe for frontend exposure with Row Level Security (RLS) enabled on all tables.
# DO NOT put your service_role / secret key here!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# -----------------------------------------------------------------
# 3. AI Provider Configuration for Frontend
# -----------------------------------------------------------------
VITE_SAATHI_AI_PROVIDER=google-gemini
VITE_SAATHI_AI_ENDPOINT=/api/saathi/chat
VITE_SAATHI_AI_MODEL=gemini-3.5-flash-lite
